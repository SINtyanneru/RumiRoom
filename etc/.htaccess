<IfModule mod_autoindex.c>
	IndexOptions +FancyIndexing HTMLTable

	HeaderName /RumiRoom/etc/HEADER.html
	ReadmeName /RumiRoom/etc/README.html
	IndexIgnore .??* *~ *# HEADER* README* RCS CVS *,v *,t
	IndexIgnore ..

	IndexOptions +DescriptionWidth=*,+SuppressHTMLPreamble

	#説明
	AddDescription "SvelteはAタグをSPAな遷移で使えるらしいのでJSで書いてみたやつ" a_tag
	AddDescription "アラビアンな文章をプレゼンテーションフォルムスBに変換するやつ" ArabB
	AddDescription "BGA" BaGuAr
	AddDescription "バベルの図書館風味" Babel
	AddDescription "ブラクラ" BrowserClasher
	AddDescription "愛媛CATVのお知らせチャンネルを真似てみた" CATV
	AddDescription "シャープのCOCORO AIRのAPIを叩くために作った、実験" COCORO_AIR
	AddDescription "FXのアレみたいなグラフを作りたかった" FX
	AddDescription "FirefoxのJSONビュワーっぽいやつ" FirefoxLikeJsonViewer
	AddDescription "GPTが出た頃に試したやつ" GPTスキュモ
	AddDescription "HLSの実験" HLS
	AddDescription "IDEを作りたかったが、普通に考えてWebベースはゴミだわ" IDE
</IfModule>

<FilesMatch ^(README.html|HEADER.html)$>
	ForceType text/html
</FilesMatch>
